R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=R4GB
VERSION=0.1.0
LANGUAGE=Zig
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=gui
MODULE_ROLE=subsystem
SUBSYSTEM_ID=r4os.gb
SUBSYSTEM_DISPLAY_NAME=Game Boy
GUEST_FORMAT=gameboy.dmg-cartridge
GUEST_EXTENSION=gameboy.dmg-cartridge:.gb
GUEST_EXTENSION=gameboy.dmg-cartridge:.gbc
GUEST_FEATURE=gameboy.dmg-cartridge:binary.rom
GUEST_FEATURE=gameboy.dmg-cartridge:probe.magic-v1.104.ceed6666cc0d000b
TARGET=/R4OS/SUBSYSTEMS/r4os.gb/R4GB.R4X
IMAGE_SCOPE=full
OPTIMIZE=speed
IMPORT=R4SYS:Query:1
IMPORT=R4DESK:Query:1
IMPORT=R4DRAW:Query:1
IMPORT=R4AUDIO:Query:1
