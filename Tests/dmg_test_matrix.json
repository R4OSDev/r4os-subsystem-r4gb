  "exclusions": [
    {"source_id":"mooneye","classification":"foreign DMG/MGB/SGB revision profile","cases":9,"revision":"DMG-CPU-0, MGB, SGB or SGB2","disposition":"excluded","reason":"Post-boot CPU, divider and MMIO values intentionally differ from the production DMG-CPU-C target."},
    {"source_id":"mooneye","classification":"CGB/AGB-only misc cases","cases":8,"revision":"CGB or AGB","disposition":"excluded","reason":"The tests require color or Advance hardware outside the monochrome subsystem scope."},
    {"source_id":"mooneye","classification":"MGB madness case","cases":1,"revision":"MGB","disposition":"excluded","reason":"The sprite/DMA probe explicitly targets Pocket hardware."},
    {"source_id":"mooneye","classification":"manual sprite-priority protocol","cases":1,"revision":"DMG","disposition":"deferred-0.72.11","reason":"Upstream declares a visual/manual success protocol; it belongs to the final user sight-test subversion."},
    {"source_id":"mooneye","classification":"boot-ROM dump utilities","cases":2,"revision":"physical hardware","disposition":"excluded","reason":"These are acquisition utilities that require a real boot ROM or hardware and are not emulator conformance tests."},
    {"source_id":"mealybug-tearoom","classification":"CGB-only second capture variants","cases":7,"revision":"CGB","disposition":"excluded","reason":"The seven *2 ROMs only have CGB expected images; there is no DMG oracle to assert."},
    {"source_id":"samesuite","classification":"CGB PCM-register APU cases","cases":68,"revision":"CGB","disposition":"excluded","reason":"Upstream uses CGB-only PCM12/PCM34 observation; only the two documented pre-CGB APU cases are applicable."},
    {"source_id":"samesuite","classification":"CGB DMA cases","cases":4,"revision":"CGB","disposition":"excluded","reason":"GDMA and HDMA are color-model facilities."},
    {"source_id":"samesuite","classification":"CGB BGPI case","cases":1,"revision":"CGB","disposition":"excluded","reason":"BGPI is a color-palette register absent on DMG."},
    {"source_id":"samesuite","classification":"SGB command cases","cases":2,"revision":"SGB","disposition":"excluded","reason":"Super Game Boy command transport is outside the monochrome handheld target."}
