  "protocols": [
    {
      "id": "sm83-exact-step",
      "success": "Exact final registers, memory writes and ordered M-cycle bus events for one legal base or CB opcode.",
      "timeout": "Exactly one instruction per vector; each JSON input is capped at 4 MiB."
    },
    {
      "id": "rom-catalog-integrity",
      "success": "Every selected ROM parses with a valid cartridge identity and the pinned file count and aggregate digest match.",
      "timeout": "No guest execution; each ROM is capped at 16 MiB."
    },
    {
      "id": "mooneye-cpu-result",
      "success": "The documented Fibonacci result 3,5,8,13,21,34 is reached; 42 in every result register is failure.",
      "timeout": "20,000,000 SM83 instructions per ROM."
    },
    {
      "id": "mooneye-machine-result",
      "success": "At the LD B,B result breakpoint the documented Fibonacci register result is present; all-42, illegal opcodes and timeout fail.",
      "timeout": "60,000,000 SM83 instructions per ROM."
    },
    {
      "id": "dmg-pixel-exact",
      "success": "All 23,040 DMG shade pixels exactly match the pinned reference PNG at the software breakpoint after its minimum frame count.",
      "timeout": "5,000,000 SM83 instructions per ROM."
    },
    {
      "id": "rtc3-ui-three-groups",
      "success": "All three RTC3Test groups return to their result screen without any red result tile.",
      "timeout": "10 guest seconds for menus and 180 guest seconds for each test group."
    }
  ],
